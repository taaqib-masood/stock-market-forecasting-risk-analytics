# ── Alpaca (free account → https://alpaca.markets) ───────────────────────────
# Used for: real-time & historical data + optional paper/live order execution
ALPACA_API_KEY=PKxxxxxxxxxxxxxxxxxxxxxxxx
ALPACA_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ALPACA_BASE_URL=https://paper-api.alpaca.markets   # change to https://api.alpaca.markets for live

# ── Webhook server ────────────────────────────────────────────────────────────
WEBHOOK_PORT=8080
WEBHOOK_CAPITAL=100000

# ── Boro release and Zerodha execution controls ──────────────────────────────
# Keep research/paper defaults until the retained release audit passes.
BORO_RELIABILITY_MODE=research
BORO_EXECUTION_MODE=paper
BORO_LIVE_CONFIRMATION=
# Private owner-only Reliance trading path; does not approve public Telegram signals.
BORO_PERSONAL_LIVE_TRADING_ACK=
BORO_LIVE_SYMBOL=RELIANCE
BORO_LIVE_CAPITAL=50000
BORO_LIVE_MAX_RISK_PCT=0.02
BORO_LIVE_MAX_NOTIONAL_PCT=0.20
BORO_OPERATIONAL_KILL_SWITCH=false
BORO_RELIABILITY_DB=results/reliability.db
BORO_TELEGRAM_AUDIENCE_DB=results/reliability.db
BORO_TELEGRAM_TERMS_VERSION=terms-v1
TELEGRAM_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
# Local cockpit authentication and browser origin restriction.
CONTROL_TOKEN=
CONTROL_ALLOW_ORIGIN=http://localhost:8765
CONTROL_BIND_HOST=127.0.0.1
CONTROL_MAX_BODY_BYTES=65536
# Legacy web dashboard is read-only unless this owner-only local token is set.
WEB_BIND_HOST=127.0.0.1
WEB_TRADE_TOKEN=
# Legacy TradingView receiver: loopback + secret required; Alpaca is paper-only and disabled.
WEBHOOK_BIND_HOST=127.0.0.1
WEBHOOK_SECRET=
WEBHOOK_ENABLE_ALPACA=
# All five values must point to independently retained, revalidated artifacts.
BORO_CORPORATE_ACTION_REVIEWED_AUDIT=
BORO_CORPORATE_ACTION_AUDIT_SHA256=
BORO_CORPORATE_ACTION_PACKET_DIR=
BORO_CORPORATE_ACTION_REVIEWER_POLICY=
BORO_CORPORATE_ACTION_BASELINE_REPORT=
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
# Optional backend-only file written by the authenticated cockpit exchange flow.
KITE_ACCESS_TOKEN_FILE=results/kite_access_token
KITE_API_BASE_URL=https://api.kite.trade
BORO_BROKER_SESSION_MAX_AGE_SECONDS=3600
